{
  "name": "joao-morais-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Portfólio cinematográfico de João Morais — exportação estática Next.js.",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "serve": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "media": "node scripts/optimize-media.mjs",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sharp": "0.35.5",
    "typescript": "~5.9.3"
  }
}
